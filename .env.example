# Neon: the pooled connection string (host contains "-pooler"), with sslmode=require.
# In production use the restricted user from scripts/sql/create-app-role.sql here (SECURITY.md §3).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/clearance?sslmode=require
# Neon: the direct (unpooled) connection string, used only by `pnpm db:migrate`
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/clearance?sslmode=require

# Public URL of the app (used for links in WhatsApp messages and cookies)
APP_URL=https://clearance.example.com

# Owner account created by `pnpm db:seed` (change the password after first login)
OWNER_USERNAME=owner
# 10+ characters, not common, not containing the username
OWNER_PASSWORD=
OWNER_NAME=المالك

TZ=Asia/Baghdad

# Set to 1 only when the app is reached exclusively through Cloudflare (trust CF-Connecting-IP for login limits)
TRUST_CLOUDFLARE=0
