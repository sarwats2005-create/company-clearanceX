{
    "name": "container-clearance",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@10.28.0",
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "next build",
        "start": "tsx scripts/setup.ts && next start",
        "typecheck": "tsc --noEmit",
        "lint": "node scripts/rtl-codemod.mjs src/components --check && node scripts/rtl-codemod.mjs src/app --check",
        "test": "vitest run",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx scripts/migrate.ts",
        "db:setup": "tsx scripts/setup.ts",
        "db:seed": "tsx src/db/seed.ts",
        "db:demo": "tsx --conditions=react-server src/db/demo.ts",
        "check:neon:auth": "node scripts/check-neon-auth.mjs",
        "check:neon:ai": "node scripts/check-neon-ai-gateway.mjs",
        "check:neon:realtime": "node scripts/check-neon-realtime.mjs",
        "audit:deps": "pnpm audit --prod"
    },
    "dependencies": {
        "@internationalized/date": "^3.12.4",
        "@neon/config": "^1.14.8",
        "@neon/env": "^2.1.11",
        "@neon/realtime": "^0.2.2",
        "@react-aria/utils": "^3.34.1",
        "@react-stately/utils": "^3.12.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@untitledui/file-icons": "^0.0.9",
        "@untitledui/icons": "^0.0.23",
        "decimal.js": "^10.6.0",
        "dotenv": "^18.0.10",
        "drizzle-orm": "~0.45.4",
        "embla-carousel-react": "^8.6.0",
        "exceljs": "4.4.0",
        "html-to-image": "1.11.11",
        "input-otp": "^1.5.0",
        "motion": "^13.4.4",
        "next": "16.4.6",
        "next-themes": "^0.4.6",
        "pg": "^8.23.1",
        "qr-code-styling": "^1.9.2",
        "react": "^19.3.0",
        "react-aria": "^3.52.1",
        "react-aria-components": "^1.21.1",
        "react-dom": "^19.3.0",
        "react-hotkeys-hook": "^5.3.3",
        "react-stately": "^3.50.0",
        "recharts": "^3.10.1",
        "server-only": "^0.0.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-react-aria-components": "^2.2.0",
        "tsx": "^4.23.15",
        "ws": "^8.23.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^26.6.3",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/ws": "^8.18.2",
        "drizzle-kit": "^0.31.11",
        "postcss": "^8.5.28",
        "postcss-loader": "^8.2.1",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^6.0.3",
        "vitest": "^5.1.1"
    },
    "engines": {
        "node": ">=22"
    },
    "pnpm": {
        "overrides": {
            "uuid": "^11.1.1",
            "postcss-selector-parser": "^6.1.5"
        }
    },
    "overrides": {
        "uuid": "^11.1.1",
        "postcss-selector-parser": "^6.1.5"
    }
}
